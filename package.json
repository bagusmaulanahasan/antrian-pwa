{
  "name": "antrian-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "sql:check": "node scripts/sql-validate.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:mock": "node scripts/smoke-with-mock.mjs",
    "smoke:mock:rls": "node scripts/smoke-with-mock.mjs --rls-error",
    "smoke:mock:notable": "node scripts/smoke-with-mock.mjs --missing-table",
    "smoke:mock:rpcopen": "node scripts/smoke-with-mock.mjs --rpc-open",
    "test:worker": "node scripts/worker-test.mjs",
    "test:queue": "node scripts/queue-test.mjs",
    "test:e2e:auth": "node scripts/auth-e2e.mjs",
    "test:e2e:admin": "node scripts/admin-e2e.mjs",
    "test:e2e:tv": "node scripts/tv-e2e.mjs",
    "test:e2e:owner": "node scripts/owner-e2e.mjs",
    "worker:dev": "node node_modules/wrangler/bin/wrangler.js dev --config worker/wrangler.toml",
    "worker:deploy": "node node_modules/wrangler/bin/wrangler.js deploy --config worker/wrangler.toml",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "test:unit": "node --experimental-strip-types --test worker/test/*.test.ts src/test/*.test.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "verify": "npm run typecheck && npm run test:unit && npm run test:worker && npm run test:queue && npm run test:e2e:auth && npm run test:e2e:admin && npm run test:e2e:tv && npm run test:e2e:owner && npm run smoke:mock && npm run smoke:mock:rls && npm run smoke:mock:notable && npm run smoke:mock:rpcopen && npm run build && npm run assets:verify",
    "verify:sequential": "node scripts/run-verify.mjs",
    "verify:ui": "npm run typecheck && npm run smoke:mock",
    "verify:auth": "npm run typecheck && npm run test:unit && npm run test:e2e:auth",
    "verify:sql": "npm run sql:check && npm run test:unit && npm run test:worker",
    "verify:queue": "npm run typecheck && npm run test:worker && npm run test:queue"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@node-rs/argon2-wasm32-wasi": "^2.2.2",
    "@supabase/supabase-js": "^2.39.0",
    "lucide-vue-next": "^0.460.0",
    "vue": "^3.3.11",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@node-rs/argon2": "^2.2.2",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "autoprefixer": "^10.4.16",
    "libpg-query": "^18.1.5",
    "postcss": "^8.4.32",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.3",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.4",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.149.0"
  }
}
