# ============================================================
#  Environment - Salin file ini menjadi `.env` lalu isi nilainya
# ============================================================

# --- Supabase (Project Settings > API) ---
# URL project Supabase, contoh: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Kunci anon / publishable. JANGAN memakai service_role di frontend.
VITE_SUPABASE_ANON_KEY=

# --- Backend API (Cloudflare Workers) ---
# Base URL Worker yang melayani /api/auth/*. Kosongkan bila belum di-deploy.
VITE_API_BASE_URL=

# --- Dashboard TV ---
# Kode PIN untuk membuka layar TV (minimal 4 karakter).
# PIN ini BUKAN rahasia: keamanan data tetap dari RLS SELECT-only.
# Kosongkan atau kurang dari 4 karakter = layar TV menampilkan pesan
# konfigurasi dan tidak terbuka sama sekali.
VITE_TV_PIN=